# syntax=docker/dockerfile:1
FROM rust:1.92-alpine AS builder
RUN apk add --no-cache build-base python3 py3-pip linux-headers \
    && rustup component add rustfmt
WORKDIR /app
COPY backend/Cargo.toml backend/Cargo.lock backend/
COPY backend/src backend/src
COPY backend/crates/meeting/Cargo.toml backend/crates/meeting/Cargo.toml
COPY backend/crates/meeting/src backend/crates/meeting/src
WORKDIR /app/backend
RUN --mount=type=cache,id=bodrik-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=bodrik-combined-release,target=/app/backend/target \
    cargo build --locked --release --bin backend && cp target/release/backend /tmp/backend

FROM alpine:3.23
RUN apk add --no-cache ffmpeg ca-certificates curl python3 quickjs libgcc libstdc++ \
    && curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp \
       -o /usr/local/bin/yt-dlp \
    && chmod a+rx /usr/local/bin/yt-dlp
WORKDIR /app
RUN adduser -D app \
    && mkdir -p /app/data /data/avatars /data/chat /data/diagnostics \
    && chown -R app:app /app /data
COPY --from=builder /tmp/backend /app/backend
COPY backend/migrations /app/migrations
COPY backend/crates/meeting/LICENSE /usr/share/licenses/meeting-backend/LICENSE
ENV BIND_ADDR=0.0.0.0:3001
EXPOSE 3001
USER app
CMD ["/app/backend"]
